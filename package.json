{
  "name": "wikibase-console",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "command line app to explore wikibase",
  "main": "dist/cli.js",
  "bin": {
    "ts-cli": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/cli.ts",
    "build": "tsc -b",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix"
  },
  "keywords": [
    "wikibase",
    "wikipedia",
    "wikimedia"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.9.0",
    "inquirer": "^12.6.1",
    "prompts": "^2.4.2",
    "wikibase-sdk": "^10.2.3"
  },
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@jest/globals": "^30.1.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/yargs-parser": "^21.0.3",
    "chalk": "^5.6.2",
    "esbuild-register": "^3.6.0",
    "eslint": "^9.35.0",
    "eslint-plugin-gb": "^9.1.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "jest-mock": "^30.0.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.43.0",
    "yargs-parser": "^21.1.1"
  }
}
